#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname $0)"/..

root="$(pwd -P)"
files_cmd="$root/script/lib/dotfiles-files"

DOTFILES="$root" "$files_cmd" --ignored '**/install.sh' | while read installer; do
    echo "› skip ./${installer#$root/} (.dotfilesignore.local)"
done

# find the installers and run them iteratively
DOTFILES="$root" "$files_cmd" '**/install.sh' | while read installer; do
    echo "› ./${installer#$root/}"
    sh -c "${installer}"
done

# Run Homebrew through the Brewfile
if test "$(uname)" = "Darwin"; then
    echo "› brew bundle"
    # brew bundle
    $DOTFILES/homebrew/my_brew_bundle
fi
